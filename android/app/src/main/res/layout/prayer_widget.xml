<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="@drawable/prayer_widget_background" android:padding="14dp">
    <TextView android:id="@+id/widget_city" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_gold" android:textSize="13sp" android:maxLines="1" android:ellipsize="end"/>
    <TextView android:id="@+id/widget_hijri" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_text" android:textSize="12sp"/>
    <TextView android:id="@+id/widget_next" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_text" android:textStyle="bold" android:textSize="17sp" android:layout_marginTop="5dp"/>
    <TextView android:id="@+id/widget_schedule" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_text" android:textSize="13sp" android:layout_marginTop="5dp"/>
    <TextView android:id="@+id/widget_diary" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_gold" android:textSize="12sp" android:layout_marginTop="5dp"/>
</LinearLayout>
